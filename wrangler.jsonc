// Cloudflare Worker for phillips-uk.com (replaces Netlify). Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phillips-uk",
  "main": "cloudflare/src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker sees every request so it can redirect the apex to www and route the function URLs.
    "run_worker_first": true
  },
  "alias": {
    "@netlify/blobs": "./cloudflare/src/shims/netlify-blobs.cjs"
  },
  // Search Desk (the product) lives in its own Worker and private repo; /desk is forwarded to it. DESK_LINKS is its
  // DemoLinks entrypoint (RPC only, never reachable over HTTP): one demo share link per invite (cloudflare/src/desk-demo.js)
  "services": [
    { "binding": "DESK", "service": "search-desk" },
    { "binding": "DESK_LINKS", "service": "search-desk", "entrypoint": "DemoLinks" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "phillips-blobs" }
  ],
  // Accounts (vault 01_Phillips/04_Products/Accounts Plan.md, 22 Nov 2026): accounts, sign-in links, saved checks and the
  // monthly email count. Western Europe, since it holds UK visitors' details. Tables: cloudflare/migrations/accounts/.
  "d1_databases": [
    { "binding": "ACCOUNTS_DB", "database_name": "phillips-accounts", "database_id": "68a0782f-ef40-4f61-826a-5397dcfa60f3", "migrations_dir": "cloudflare/migrations/accounts" }
  ],
  // EMAIL: account emails (sign-in links, report emails) through Cloudflare Email Sending. phillips-uk.com onboarded
  // 22 Nov 2026 with its records on cf-bounce.phillips-uk.com only (the root's Google Workspace MX, SPF and DMARC are
  // untouched). Only this sender. Workers Paid includes 3,000 a month across the account (Search Desk shares it), then
  // $0.35 per 1,000, so accounts.js stops at 2,000 a month (Lewis, 22 Nov 2026: no charges). Locally nothing is sent.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["contact@phillips-uk.com"] }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "phillips-jobs" }],
    "consumers": [{ "queue": "phillips-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 0 }]
  },
  "limits": { "cpu_ms": 300000 },
  // The Monday Brief (cloudflare/src/brief.js). Cron times are UTC, and days are named because Cloudflare numbers days
  // differently from standard cron. Monday 06:00 and 07:00 both fire and only the one that is 07:00 in London sends
  // (BST and GMT). Friday 16:00: tell Lewis if the draft is ready. Sunday 18:00: remind him if it isn't approved.
  // An issue is only ever sent after Lewis approves it in /admin.
  "triggers": { "crons": ["0 6 * * MON", "0 7 * * MON", "0 16 * * FRI", "0 18 * * SUN", "15 5 * * *"] },
  // Zone phillips-uk.com is on Cloudflare (nameservers kirk/nataly) since 2026-10-20. The Worker redirects the apex to www.
  "routes": [
    { "pattern": "www.phillips-uk.com", "custom_domain": true },
    { "pattern": "phillips-uk.com", "custom_domain": true }
  ]
}
